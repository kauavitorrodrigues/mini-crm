{
    "name": "@mini-crm/database",
    "version": "0.1.0",
    "private": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "check-types": "tsc --noEmit",
        "test": "pnpm env:load vitest run",
        "env:load": "dotenv -e ../../.env --",
        "db:generate": "pnpm env:load drizzle-kit generate --name",
        "db:migrate": "pnpm env:load drizzle-kit migrate",
        "db:deploy": "pnpm env:load drizzle-kit migrate",
        "db:studio": "pnpm env:load drizzle-kit studio",
        "db:seed": "pnpm env:load tsx src/seed.ts"
    },
    "dependencies": {
        "@mini-crm/contracts": "workspace:*",
        "bcryptjs": "3.0.3",
        "drizzle-orm": "0.45.4",
        "pg": "8.23.1",
        "uuid": "14.0.3"
    },
    "devDependencies": {
        "@mini-crm/tsconfig": "workspace:*",
        "@mini-crm/vitest-config": "workspace:*",
        "@types/bcryptjs": "3.0.0",
        "@types/node": "26.6.6",
        "@types/pg": "8.23.1",
        "dotenv-cli": "11.1.0",
        "drizzle-kit": "0.31.11",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    }
}
