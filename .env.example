# API
SERVER_PORT=4353

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

POSTGRES_DB=mini-crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5485

# Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_PORT and POSTGRES_DB above
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5485/mini-crm

FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:4353

# Initial user created by `db:seed` (single user, no public signup)
SEED_USER_NAME=Admin
SEED_USER_EMAIL=admin@mini-crm.com
SEED_USER_PASSWORD=change_me_please

# Frontend (Vite)
VITE_BASE_API_URL=http://localhost:4353

# Login demo button (academic project: shows a button that fills these on the login page)
VITE_DEMO_EMAIL=admin@mini-crm.com
VITE_DEMO_PASSWORD=change_me_please
