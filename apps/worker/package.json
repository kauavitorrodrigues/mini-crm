{
    "name": "worker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "tsup",
        "start": "pnpm env:load node dist/worker.js",
        "dev": "pnpm env:load tsx watch src/worker.ts",
        "env:load": "dotenv -e ../../.env --",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@mini-crm/infra": "workspace:*",
        "@mini-crm/jobs": "workspace:*"
    },
    "devDependencies": {
        "@mini-crm/tsconfig": "workspace:*",
        "@types/node": "26.6.6",
        "dotenv-cli": "11.1.0",
        "tsup": "9.0.0",
        "tsx": "4.23.15",
        "typescript": "7.0.2"
    }
}
