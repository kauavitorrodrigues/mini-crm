{
    "extends": "@mini-crm/tsconfig/node-app.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "declaration": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strictPropertyInitialization": false,
        "types": ["node", "express"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
