        "check-types": "tsc --noEmit",
        "test": "pnpm env:load vitest run"
    },
    "dependencies": {
        "@mini-crm/contracts": "workspace:*",
        "@mini-crm/core": "workspace:*",
        "@mini-crm/routes": "workspace:*",
        "@nestjs/common": "12.3.2",
        "@nestjs/config": "12.0.1",
        "@nestjs/core": "12.3.2",
        "@nestjs/platform-express": "12.3.2",
        "@nestjs/swagger": "12.0.5",
        "cookie-parser": "1.4.7",
        "helmet": "8.3.0",
        "jsonwebtoken": "9.0.3",
        "nestjs-zod": "5.5.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@mini-crm/database": "workspace:*",
        "@mini-crm/tsconfig": "workspace:*",
        "@mini-crm/vitest-config": "workspace:*",
        "@nestjs/testing": "12.3.2",
        "@swc/core": "1.16.21",
        "@types/cookie-parser": "1.4.10",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/node": "26.6.6",
        "@types/supertest": "7.2.1",
        "dotenv-cli": "11.1.0",
        "esbuild": "0.28.2",
        "supertest": "7.3.1",
        "tsup": "9.0.0",
        "typescript": "7.0.2"
    }
