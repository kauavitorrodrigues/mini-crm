{
    "name": "api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "tsup",
        "start": "pnpm env:load node dist/main.js",
        "dev": "pnpm env:load tsup --watch --onSuccess \"node dist/main.js\"",
